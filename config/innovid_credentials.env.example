# Innovid Campaign Manager credentials.
#
# Copy this file to `innovid_credentials.env` (same folder, drop the
# .example) and fill in your own values. That copy is gitignored, so
# it never leaves your machine and never reaches GitHub.
#
# QA2 uses it to read the fields no export carries: Verification
# Partner, creative rotation weight, and creative flight dates.
# Without it, QA2 runs exactly as before -- just without those checks.

INNOVID_USERNAME=your.name@wppmedia.com
INNOVID_PASSWORD=your-password-here

# Only change this if Innovid moves its login page.
INNOVID_LOGIN_URL=https://campaign-manager.flashtalking.net
